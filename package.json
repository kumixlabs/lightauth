  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "clean:all": "rm -rf bun.lock dist node_modules src-tauri/Cargo.lock src-tauri/gen src-tauri/target",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "format": "biome format --write",
    "format:check": "biome check",
    "types:check": "tsc --noEmit",
    "test": "bun test",
    "tauri": "tauri",
    "bump": "bumpp"
  },
  "homepage": "https://github.com/kumixlabs/lightauth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumixlabs/lightauth.git"
  },
  "bugs": {
    "url": "https://github.com/kumixlabs/lightauth/issues"
  },
  "dependencies": {
