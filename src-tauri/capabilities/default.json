{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "LightAuth default permissions",
  "identifier": "default",
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "process:allow-restart",
    "updater:default"
  ],
  "windows": [
    "main"
  ]
}